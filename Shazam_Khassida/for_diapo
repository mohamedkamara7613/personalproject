def extract_peaks(spectrogram, amp_min=-40, neighborhood_size=20):
    """
    Trouve les pics locaux dans le spectrogramme.
    """
    # Masque booléen des maximums locaux
    local_max = ndimage.maximum_filter(spectrogram, size=neighborhood_size) == spectrogram
    
    # Masque d'amplitude minimale
    background = (spectrogram == 0)
    eroded_background = ndimage.binary_erosion(background, structure=np.ones((neighborhood_size, neighborhood_size)), border_value=1)
    
    # On combine : max local ET amplitude > amp_min ET pas dans le background "plat"
    peaks = local_max ^ eroded_background
    peaks = peaks & (spectrogram > amp_min)
    
    # Coordonnées (fréquence_idx, temps_idx) des pics
    freq_bins, time_frames = np.where(peaks)
    
    return list(zip(freq_bins, time_frames))
