    """
    from scipy import ndimage
    import numpy as np
    
    # 1. Masque booléen : True seulement si le pixel est le maximum de son voisinage 20x20
    local_max = ndimage.maximum_filter(spectrogram, size=neighborhood_size) == spectrogram
    
    # 2. Masque d'amplitude : True seulement si le son est assez fort
    is_loud_enough = spectrogram > amp_min
    
    # 3. On combine les deux conditions
    peaks = local_max & is_loud_enough
    
    # 4. On récupère les coordonnées (fréquence_idx, temps_idx) des pics trouvés
    freq_bins, time_frames = np.where(peaks)
    
    return list(zip(freq_bins, time_frames))

